<Window x:Class="Nakawari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nakawari.ViewModels"
        Title="Nakawari" Width="1380" Height="820" MinWidth="1240" MinHeight="600"
        Icon="/Assets/nakawari.ico" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">

    <Window.Background>
        <ImageBrush ImageSource="{DynamicResource BackgroundImage}" Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Bottom"/>
    </Window.Background>

    <Window.Resources>
        <!-- MFG state pill colors -->
        <Style x:Key="StatePill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Enabled}">
                    <Setter Property="Background" Value="{DynamicResource OkBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.UpdateAvailable}">
                    <Setter Property="Background" Value="{DynamicResource WarnBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Attention}">
                    <Setter Property="Background" Value="{DynamicResource WarnBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Working}">
                    <Setter Property="Background" Value="{DynamicResource OkBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Blocked}">
                    <Setter Property="Background" Value="{DynamicResource BadBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Enabled}">
                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.UpdateAvailable}">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Attention}">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Working}">
                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Blocked}">
                    <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowState.Ready}">
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Enable = red kite button; Disable = quiet paper button -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PaperSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: brand over the sky, mascot narrating what is going on -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="18,14" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/icon-256.png" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nakawari" FontSize="27"/>
                            <TextBlock Text="中割り" FontFamily="{StaticResource KanjiFont}" FontSize="17"
                                       Foreground="{DynamicResource Accent}" Margin="8,6,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Tagline}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,36,24,0">
                <Border Style="{StaticResource Card}" Padding="16,12" CornerRadius="16" MaxWidth="250" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Narration}" TextWrapping="Wrap" FontSize="13" LineHeight="19"/>
                </Border>
                <Path Data="M 0,0 L 18,0 L 4,16 Z" Fill="{DynamicResource Paper}" Margin="56,-1,0,0" HorizontalAlignment="Left"/>
                <Image Source="/Assets/mascot.png" Width="170" Height="170" HorizontalAlignment="Left" Margin="0,2,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="Bob"/>
                    </Image.RenderTransform>
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="Bob" Storyboard.TargetProperty="Y"
                                                     From="0" To="-9" Duration="0:0:2.4">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Image.Triggers>
                </Image>
            </StackPanel>
        </Grid>

        <!-- Right: everything you act on -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar card -->
            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <Button Content="Update all" Style="{StaticResource Primary}" Command="{Binding UpdateAllCommand}"
                                ToolTip="Bring every enabled game up to the newest addon, ReShade and DLSS-G found"/>
                        <Button Content="Rescan" Command="{Binding RefreshCommand}"/>
                        <Button Content="Add game folder" Command="{Binding AddFolderCommand}"/>
                        <Button Content="DLSS-G folder" Command="{Binding OpenDlssgFolderCommand}"
                                ToolTip="Drop a newer nvngx_dlssg.dll here and it becomes the version used for upgrades"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" FontSize="12" Text="{Binding GpuText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GpuWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}" Text="{Binding AddonText}"/>
                            </StackPanel>
                            <Button Style="{StaticResource Round}" Content="{Binding ThemeGlyph}" Command="{Binding ToggleThemeCommand}"
                                    ToolTip="{Binding ThemeTip}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Round}" Content="?" Command="{Binding AboutCommand}"
                                    ToolTip="About Nakawari" Margin="0"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,12,0,0">
                        <CheckBox Content="Show all games" IsChecked="{Binding ShowAllGames}"/>
                        <CheckBox Content="Upgrade old DLSS-G" IsChecked="{Binding UpgradeDlssg}"
                                  ToolTip="Replace a game's outdated nvngx_dlssg.dll with the newest one on this PC (original is backed up)"/>
                        <CheckBox Content="Auto-update at sign-in" IsChecked="{Binding UpdateAtSignIn}"
                                  ToolTip="At sign-in: update and repair enabled games, and tell you about newly installed frame-gen games"/>
                        <CheckBox Content="Auto-enable new games" IsChecked="{Binding AutoEnableNewGames}"
                                  ToolTip="Enable MFG by itself on newly installed games that support it (anti-cheat games are always skipped)"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding ScsKillerText}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column captions -->
            <Grid Grid.Row="1" Margin="18,18,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="98"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="GAME"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="DLSS-G"/>
                <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="FRAME GENERATION"/>
                <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="SHADERS"/>
                <TextBlock Grid.Column="5" Style="{StaticResource Caption}" Text="MULTIPLIER"/>
            </Grid>

            <!-- Games -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="14" Padding="10,10,14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="196"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="98"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover art (Steam) or the mascot on a sky tile -->
                                    <Border Width="116" Height="54" CornerRadius="9" HorizontalAlignment="Left" Background="{DynamicResource NeutralBg}" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="/Assets/mascot.png" Width="44" Height="44" Opacity="0.85"/>
                                            <Border CornerRadius="9">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Store}"/>
                                            <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource Warn}" Margin="10,0,0,0"
                                                       Text="{Binding Note}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                                                       Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
                                        </StackPanel>
                                        <Button Content="{Binding PacingText}" Click="OpenMenu" Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Left" Margin="0,3,0,0"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource Visible}}"
                                                ToolTip="How generated frames are paced. Smooth (G-SYNC / VRR) is closest to the 50-series feel.">
                                            <Button.ContextMenu>
                                                <ContextMenu ItemsSource="{Binding PacingCommands}">
                                                    <ContextMenu.ItemContainerStyle>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Header" Value="{Binding Label}"/>
                                                            <Setter Property="Command" Value="{Binding Command}"/>
                                                        </Style>
                                                    </ContextMenu.ItemContainerStyle>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding KitAvailable, Converter={StaticResource Visible}}">
                                            <Hyperlink Command="{Binding ToggleKitCommand}" Foreground="{DynamicResource Sky}" TextDecorations="{x:Null}">
                                                <Run Text="{Binding KitText, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding DlssgText}"/>

                                    <Border Grid.Column="3" Style="{StaticResource StatePill}">
                                        <TextBlock Style="{StaticResource StateText}" Text="{Binding StateText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StateTip}"/>
                                    </Border>

                                    <Button Grid.Column="4" Content="{Binding ScsKillerText}" ToolTip="{Binding ShaderTip}" Click="OpenMenu"
                                            HorizontalAlignment="Left" Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="12">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding CompileText}" Command="{Binding CompileShadersCommand}"/>
                                                <MenuItem Header="Turn on SCSKiller recording" Command="{Binding RecordShadersCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Open SCSKiller" Command="{Binding OpenScsKillerCommand}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>

                                    <Button Grid.Column="5" Content="{Binding MultiplierText}" Command="{Binding CycleMultiplierCommand}"
                                            HorizontalAlignment="Left" MinWidth="100" Height="34" Padding="10,0" Margin="0"
                                            ToolTip="{Binding MultiplierTip}"/>

                                    <Button Grid.Column="6" Content="{Binding ActionText}" Command="{Binding ToggleCommand}"
                                            Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Height="34"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,9" CornerRadius="14" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Width="70" Height="4" IsIndeterminate="True" Margin="0,0,12,0" BorderThickness="0"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource NeutralBg}"
                                 Visibility="{Binding Busy, Converter={StaticResource Visible}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" FontSize="12"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,14,0"
                               Visibility="{Binding AppUpdateAvailable, Converter={StaticResource Visible}}">
                        <Hyperlink Command="{Binding UpdateAppCommand}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold">
                            <Run Text="{Binding AppUpdateText, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}">
                        <Hyperlink Command="{Binding ReportProblemCommand}" Foreground="{DynamicResource Sky}">Report a problem</Hyperlink>
                        <Run Text="  |  "/>
                        <Hyperlink Command="{Binding OpenLogCommand}" Foreground="{DynamicResource Sky}">Log</Hyperlink>
                        <Run Text="{Binding VersionText, Mode=OneWay}"/>
                    </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
