<Window x:Class="Nakawari.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Nakawari" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/Assets/nakawari.ico"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">
    <Window.Background>
        <ImageBrush ImageSource="{DynamicResource BackgroundImage}" Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Bottom"/>
    </Window.Background>

    <Border Style="{StaticResource Card}" Margin="22" Padding="24,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/mascot.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nakawari" FontSize="28"/>
                        <TextBlock Text="中割り" FontFamily="{StaticResource KanjiFont}" FontSize="18" Foreground="{DynamicResource Accent}" Margin="8,7,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionLine" Style="{StaticResource Muted}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Nakawari means the in-between drawings animators place between key frames: exactly what frame generation does."/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Standing on the shoulders of" Margin="0,18,0,6" FontSize="14"/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12">
                <Run Text="• MFG Unlock addon: mavismmg, from ImDreamt's RenoDX addon and dashdogy's research (MIT)"/><LineBreak/>
                <Run Text="• ReShade: crosire (BSD-3-Clause), downloaded from reshade.me"/><LineBreak/>
                <Run Text="• SCSKiller: BlueHeisenberg (GPL-3.0). Used as a separate app through its command line, not bundled"/><LineBreak/>
                <Run Text="• Varela Round font: The Varela Round Project Authors (SIL OFL 1.1)"/><LineBreak/>
                <Run Text="• Art in this build: simple placeholder graphics. The original Nakawari paintings belong to AbudiHadi and are not part of the open-source release"/>
            </TextBlock>

            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Not affiliated with or endorsed by NVIDIA, ReShade, RenoDX or SCSKiller. Use frame-generation mods in single-player games only."/>

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button Content="Project page" Click="OpenRepo"/>
                <Button Content="Close" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="0" IsCancel="True" Click="CloseWindow"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
