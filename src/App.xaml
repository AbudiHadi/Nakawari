<Application x:Class="Nakawari.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeService swaps this for Night.xaml at startup when needed. -->
                <ResourceDictionary Source="/Themes/Day.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Varela Round</FontFamily>
            <FontFamily x:Key="KanjiFont">Yu Mincho, MS Mincho</FontFamily>
            <BooleanToVisibilityConverter x:Key="Visible"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

            <!-- Paper card floating over the painting. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Paper}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="20,16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#1E2430"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Padding" Value="11,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource NeutralBg}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Background" Value="{DynamicResource PaperSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PaperHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Chrome" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small round icon button (theme toggle, about). -->
            <Style x:Key="Round" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <!-- CheckBox drawn as a soft toggle switch. -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,18,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" Background="{DynamicResource NeutralBg}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                                    <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource InkSoft}"
                                             HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A button that looks like a small link (used for per-game menus). -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Sky}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Explicit TextBlock: the app-wide TextBlock style would otherwise override size and color. -->
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource Paper}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="Padding" Value="4"/>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Paper}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>

            <!-- Thin, quiet scrollbar that doesn't fight the painting. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="{DynamicResource InkSoft}" Opacity="0.45" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
